#include "mini_list.h"
#include "mini_printk.h"

#include <stdio.h>

void mini_init_list_head(mini_list_head_t *list)
{
	list->next = list->prev = list;
	//list->prev = list;
}

static void mini_list_add_between(mini_list_head_t *new_node,
																	mini_list_head_t *prev,
																	mini_list_head_t *next)
{
	next->prev = new_node;
	new_node->next = next;
	new_node->prev = prev;
	prev->next = new_node;
}

void mini_list_add_tail(mini_list_head_t *new_node, mini_list_head_t *head)
{
	mini_list_add_between(new_node, head->prev, head);

	mini_printk(MINI_LOG_INFO,
							"mini_list add tail: node=%p",
							(void*)new_node);

}

void mini_list_del(mini_list_head_t *entry)
{
	mini_list_head_t *prev = entry->prev;
	mini_list_head_t *next = entry->next;

	prev->next = next;
	next->prev = prev;

	entry->next = entry;
	entry->prev = entry;

	mini_printk(MINI_LOG_INFO,
							"mini_list delete: node=%p",
							(void *)entry);
}

int mini_list_empty(mini_list_head_t *head)
{
	return head->next == head;
}

void mini_list_show_raw(mini_list_head_t *head)
{
	mini_list_head_t *current = head->next;
	int index = 0;

	printf("\n===== Mini List Raw =====\n");

	if (mini_list_empty(head)) {
		printf("list is empty\n");
		printf("============================\n");
		return;
	}

	while (current != head) {
		printf("node[%d]=%p, prev=%p, next=%p\n",
					index,
					(void*)current,
					(void*)current->prev,
					(void*)current->next);

		current = current->next;
		index++;
	}

	printf("============================\n");
}
